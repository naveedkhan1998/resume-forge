# Environment Configuration
DEBUG=True
SECRET_KEY=dev-secret-key-resume-builder-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Database (PostgreSQL + pgvector, or set USE_SQLITE=1 for local SQLite)
USE_SQLITE=False
POSTGRES_DB=resumebuilder
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resumebuilder

# Redis & Cache
REDIS_URL=redis://localhost:6379/0

# Default Local Ollama Configuration
# Presets:
#   - Host native:        http://localhost:11434 or http://127.0.0.1:11434
#   - Docker (Mac/Win):   http://host.docker.internal:11434
#   - Docker (Linux):     http://172.17.0.1:11434
#   - Docker Compose svc: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=qwen3.5:9b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=600.0

# Hidden System-Level Fallback LLM Configuration (Server-Side Only — NEVER Exposed via API)
# Used automatically when a user has not configured their own LLM or their local Ollama is unreachable.
# Supported providers: pydantic_gateway | ollama
SYSTEM_LLM_PROVIDER=pydantic_gateway
SYSTEM_LLM_BASE_URL=https://gateway.pydantic.dev/v1
SYSTEM_LLM_API_KEY=your-pydantic-gateway-api-key-here
SYSTEM_LLM_MODEL=qwen3.5:9b

# Optional aliases supported by config/settings.py for Pydantic AI Gateway fallback:
# PYDANTIC_GATEWAY_URL=https://gateway.pydantic.dev/v1
# PYDANTIC_GATEWAY_API_KEY=your-pydantic-gateway-api-key-here
# PYDANTIC_GATEWAY_MODEL=qwen3.5:9b

