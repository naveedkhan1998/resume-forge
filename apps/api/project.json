{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose --profile full up --build --remove-orphans --abort-on-container-exit api"
      }
    },
    "serve-local": {
      "executor": "nx:run-commands",
      "options": {
        "command": ".venv/bin/python apps/api/manage.py runserver 0.0.0.0:8000"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": ".venv/bin/python apps/api/manage.py migrate"
      }
    },
    "makemigrations": {
      "executor": "nx:run-commands",
      "options": {
        "command": ".venv/bin/python apps/api/manage.py makemigrations"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": ".venv/bin/python apps/api/manage.py test"
      }
    }
  }
}
