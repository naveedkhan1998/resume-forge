FROM python:3.12-slim-trixie

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_SYSTEM_PYTHON=1 \
    UV_NO_CACHE=1

WORKDIR /app

# Copy project metadata and install only required Python dependencies using ephemeral uv mount
COPY apps/api/pyproject.toml apps/api/README.md /app/apps/api/
RUN --mount=from=ghcr.io/astral-sh/uv:latest,source=/uv,target=/bin/uv \
    uv pip install --no-cache -e /app/apps/api

# Copy backend code
COPY apps/api /app/apps/api

EXPOSE 8000
CMD ["python", "apps/api/manage.py", "runserver", "0.0.0.0:8000"]
